# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mydb?sslmode=disable
DB_PASSWORD=postgres

# JWT Configuration
# IMPORTANT: JWT_SECRET must be at least 32 characters long for security
# Generate a strong random secret for production using: openssl rand -base64 32
# NEVER commit your actual JWT_SECRET to version control
JWT_SECRET=your-secret-key-here-must-be-at-least-32-characters-long

# Server Configuration
PORT=3000
