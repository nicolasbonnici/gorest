# Database Configuration
# IMPORTANT: Use sslmode=require or sslmode=verify-full in production!
DATABASE_URL=postgres://username:password@localhost:5432/dbname?sslmode=require
DB_PASSWORD=your_secure_password_here

# JWT Configuration
# REQUIRED: Generate a strong random secret using: openssl rand -base64 32
# Minimum 32 characters required - DO NOT use this placeholder!
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
# JWT token expiration time in seconds (default: 900 = 15 minutes)
JWT_TTL=900

# Pagination Configuration
PAGINATION_LIMIT=10
PAGINATION_MAX_LIMIT=1000

# Server Configuration
PORT=3000
ENVIRONMENT=dev

# CORS Configuration
# Comma-separated list of allowed origins for production (e.g., "https://app.example.com,https://admin.example.com")
# Leave empty or set to "*" for development (allows all origins - NOT recommended for production)
CORS_ORIGINS=
