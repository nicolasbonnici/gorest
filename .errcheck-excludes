# Errcheck exclusions for GoREST (non-test code only, tests are ignored via -ignoretests)

# Deferred Close operations - cleanup code where errors are not actionable
(*.Rows).Close
(*os.File).Close

# Transaction rollbacks in error paths - already handling the error
(*.Tx).Rollback

# Migration lock releases - already in defer, errors logged elsewhere
(github.com/nicolasbonnici/gorest/migrations.Lock).Release

# Migration tracker operations in error handling paths
(github.com/nicolasbonnici/gorest/migrations.MigrationTracker).RecordFailedMigration
