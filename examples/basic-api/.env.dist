# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mydb?sslmode=disable

# JWT Authentication
JWT_SECRET=your-secret-key-minimum-32-characters-long

# Server Configuration (optional, defaults from gorest.yaml will be used)
# PORT=3000
# ENVIRONMENT=development

# Pagination (optional, defaults from gorest.yaml)
# PAGINATION_LIMIT=10
# PAGINATION_MAX_LIMIT=1000

# CORS (optional, defaults from gorest.yaml)
# CORS_ORIGINS=*
