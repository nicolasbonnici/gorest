# Binaries
/bin/
gorest
*.exe
*.dll
*.so
*.dylib

# Test binary
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# IDE
.vscode/
.idea/

# Environment variables
.env
.env.local

# Coompiled binary
bin/*

# OpenAPI spec resource schemas generation
internal/api/openapi/*
!internal/api/openapi/.gitkeep

# Models scaffolded from database schema
internal/api/models/*
!internal/api/models/.gitkeep
!internal/api/models/user.go

# API resources scaffolded from models
internal/api/resources/*
!internal/api/resources/.gitkeep
!internal/api/resources/user.go


# API resources DTOs scaffolded from resources
internal/api/dtos/*
!internal/api/dtos/.gitkeep
!internal/api/dtos/user.go

# Route registration scaffolded from resources
internal/api/routes.go

# Custom business logic hooks
internal/hooks/*
!internal/hooks/.gitkeep
!internal/hooks/factory.go
!internal/hooks.go
!internal/hooks/user.go
