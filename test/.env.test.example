# Test Environment Variables
# Copy this file to .env.test and update with actual values

# PostgreSQL test database connection (matches compose.override.test.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/mydb_test?sslmode=disable

# JWT secret for test authentication (minimum 32 characters)
JWT_SECRET=test-secret-key-minimum-32-characters-long-for-jwt-testing
